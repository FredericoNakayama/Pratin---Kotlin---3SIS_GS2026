    <!-- Sobre -->
    <string name="sobre_titulo">Sobre o Pratin</string>
    <string name="sobre_problema_titulo">O problema</string>
    <string name="sobre_problema">Padarias, mercados e restaurantes descartam alimentos ainda próprios para consumo porque estão perto do vencimento, enquanto famílias do mesmo bairro passam fome. Comércio e ONG estão próximos, mas não se conectam.</string>
    <string name="sobre_publico_titulo">Quem é beneficiado</string>
    <string name="sobre_publico">Pessoas em insegurança alimentar atendidas por ONGs, voluntários que buscam doações e pequenos empreendedores que querem doar o excedente em vez de jogá-lo fora.</string>
    <string name="sobre_como_titulo">Como funciona</string>
    <string name="sobre_passo_1">O estabelecimento anuncia um lote de alimento que vence em até 7 dias, com uma janela de retirada.</string>
    <string name="sobre_passo_2">A ONG reserva o lote e recebe um código de retirada de 6 caracteres.</string>
    <string name="sobre_passo_3">Na retirada, o estabelecimento digita o código e a doação é concluída. A doação é sempre gratuita.</string>
    <string name="sobre_ods_titulo">Objetivos de Desenvolvimento Sustentável</string>
    <string name="sobre_ods2_titulo">ODS 2 — Fome zero</string>
    <string name="sobre_ods2">Leva alimento seguro, que seria descartado, até quem precisa por meio das ONGs.</string>
    <string name="sobre_ods12_titulo">ODS 12 — Consumo e produção responsáveis</string>
    <string name="sobre_ods12">Dá ao comércio um destino útil para o excedente e reduz o desperdício de alimentos no varejo.</string>
    <string name="sobre_prototipo_titulo">Sobre este protótipo</string>
    <string name="sobre_prototipo">Protótipo acadêmico da Global Solution FIAP 2026. Os dados ficam no próprio aparelho e os anúncios iniciais são exemplos. O app não está integrado a serviços externos ou públicos.</string>
    <string name="sobre_equipe_titulo">Equipe</string>
    <string name="sobre_equipe">Frederico Nakayama Sant\'anna — RM555350\nJoão Pedro Veloso Pilon — RM556199</string>

